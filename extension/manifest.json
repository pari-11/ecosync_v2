{
  "manifest_version": 3,
  "name": "EcoSync",
  "version": "1.0",
  "description": "Carbon-aware tab and download monitoring",
  "permissions": [
    "tabs",
    "scripting",
    "notifications",
    "alarms",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/index.html"
  },
  "icons": {
    "48": "icons/globe.png"
  }
}